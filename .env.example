# PaperLeaf 本地部署示例。复制为 .env 后务必替换全部 replace-* 值。

# 对外端口
PAPERLEAF_BIND_ADDRESS=127.0.0.1
PAPERLEAF_WEB_PORT=3000
PAPERLEAF_API_PORT=8000
PAPERLEAF_MINIO_PORT=9000
PAPERLEAF_MINIO_CONSOLE_PORT=9001

# Web 在浏览器中访问 API 的地址。生产环境建议通过同域反向代理暴露 /api。
NEXT_PUBLIC_DATA_MODE=real
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=paperleaf
POSTGRES_USER=paperleaf
# Compose 会把该值写入连接 URL，请使用 URL-safe 随机字符。
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# PaperLeaf 服务
PAPERLEAF_MODE=production
PAPERLEAF_SESSION_SECRET=replace-with-at-least-64-random-characters
PAPERLEAF_SECURE_COOKIES=false
PAPERLEAF_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PAPERLEAF_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PAPERLEAF_MAX_PDF_BYTES=52428800
PAPERLEAF_MAX_PDF_PAGES=500
PAPERLEAF_CHUNK_TARGET_TOKENS=700
PAPERLEAF_CHUNK_OVERLAP_TOKENS=100
PAPERLEAF_CHUNK_SEMANTIC_UNIT_TOKENS=220
PAPERLEAF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis 只保存可丢失的短期运行态：跨 API 实例限流计数和幂等判定。
# 用户、任务、会话与 Agent 事件仍以 PostgreSQL 为唯一真相源。
PAPERLEAF_REDIS_URL=redis://redis:6379/0
PAPERLEAF_REDIS_KEY_PREFIX=paperleaf
PAPERLEAF_REDIS_TIMEOUT_SECONDS=0.5
PAPERLEAF_REDIS_MAXMEMORY=256mb
PAPERLEAF_AGENT_RATE_LIMIT_REQUESTS=12
PAPERLEAF_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
PAPERLEAF_CONTEXT_ENGINE_ENABLED=false
PAPERLEAF_MEMORY_ENABLED=false
PAPERLEAF_SKILLS_ENABLED=false
PAPERLEAF_FUNCTION_TOOLS_ENABLED=false
PAPERLEAF_MCP_ENABLED=false
PAPERLEAF_ACADEMIC_MCP_URL=http://academic-search-mcp:8080/mcp
PAPERLEAF_ACADEMIC_MCP_ALLOWED_HOSTS=academic-search-mcp
PAPERLEAF_MCP_TIMEOUT_SECONDS=15
PAPERLEAF_MCP_CACHE_TTL_SECONDS=900
PAPERLEAF_MCP_CIRCUIT_FAILURE_THRESHOLD=3
PAPERLEAF_MCP_CIRCUIT_COOLDOWN_SECONDS=60
PAPERLEAF_ACADEMIC_HTTP_TIMEOUT_SECONDS=12
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PAPERLEAF_MODEL_CONTEXT_TOKENS=32768
PAPERLEAF_CONTEXT_SAFETY_RATIO=0.10
PAPERLEAF_CONTEXT_COMPACT_RATIO=0.70
PAPERLEAF_CONTEXT_HARD_LIMIT_RATIO=0.85
PAPERLEAF_CONTEXT_KEEP_RECENT_TURNS=6
PAPERLEAF_CONTEXT_MAX_MEMORIES=5
PAPERLEAF_CONTEXT_MAX_SKILLS=1
PAPERLEAF_WORKER_METRICS_PORT=9101
PAPERLEAF_PROMETHEUS_IMAGE=ghcr.io/prometheus/prometheus:v3.13.2
PAPERLEAF_GRAFANA_BASE_IMAGE=public.ecr.aws/docker/library/debian:bookworm-slim
PAPERLEAF_PROMETHEUS_PORT=9090
PAPERLEAF_GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001/d/paperleaf-rag/paperleaf-rag

# MinIO；容器内 Endpoint 不要写 http:// 前缀。
MINIO_ROOT_USER=paperleaf
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
PAPERLEAF_MINIO_BUCKET=paperleaf-pdfs

# OpenAI-compatible 服务。Key 留空时使用全文检索与确定性降级，不调用外部模型。
PAPERLEAF_OPENAI_API_KEY=
PAPERLEAF_OPENAI_BASE_URL=https://api.openai.com/v1
PAPERLEAF_CHAT_MODEL=gpt-4.1-mini
PAPERLEAF_EMBEDDING_ENABLED=true
PAPERLEAF_EMBEDDING_MODEL=text-embedding-3-small
PAPERLEAF_EMBEDDING_DIMENSIONS=
PAPERLEAF_EMBEDDING_BATCH_SIZE=8
PAPERLEAF_VISION_MODEL=

# 可选备用 OpenAI-compatible 服务。主服务超时、限流或临时失败时自动切换。
PAPERLEAF_FALLBACK_OPENAI_API_KEY=
PAPERLEAF_FALLBACK_OPENAI_BASE_URL=https://api.openai.com/v1
PAPERLEAF_FALLBACK_CHAT_MODEL=gpt-4.1-mini
PAPERLEAF_FALLBACK_EMBEDDING_ENABLED=true
PAPERLEAF_FALLBACK_EMBEDDING_MODEL=text-embedding-3-small
PAPERLEAF_FALLBACK_VISION_MODEL=

# 模型调用策略：超时、单服务尝试次数，以及熔断阈值和冷却时间。
PAPERLEAF_MODEL_TIMEOUT_SECONDS=30
PAPERLEAF_TRANSLATION_TIMEOUT_SECONDS=90
# 全文概括与结构图需要生成并校验结构化 JSON，使用独立且更宽裕的超时。
PAPERLEAF_ARTIFACT_TIMEOUT_SECONDS=120
PAPERLEAF_ARTIFACT_RETRY_TIMEOUT_SECONDS=90
PAPERLEAF_STRUCTURE_TIMEOUT_SECONDS=180
PAPERLEAF_STRUCTURE_RETRY_TIMEOUT_SECONDS=120
PAPERLEAF_MODEL_ATTEMPTS_PER_PROVIDER=1
PAPERLEAF_MODEL_CIRCUIT_FAILURE_THRESHOLD=3
PAPERLEAF_MODEL_CIRCUIT_COOLDOWN_SECONDS=30

# 证据质量门禁。范围均为 0~1；修改前应在独立 dev 集校准，并在未参与调参的 holdout 验证。
PAPERLEAF_EVIDENCE_MIN_CONFIDENCE=0.35
PAPERLEAF_EVIDENCE_MIN_VECTOR_SCORE=0.35
PAPERLEAF_EVIDENCE_MIN_LEXICAL_COVERAGE=0.18

# 生成后主张—证据门禁：每条事实主张都需要引用；无模型时还要求主张与引用原文有可复核重合。
PAPERLEAF_ANSWER_MIN_CITATION_COVERAGE=1.0
PAPERLEAF_ANSWER_MIN_CLAIM_LEXICAL_SUPPORT=0.12
PAPERLEAF_ANSWER_MIN_SUPPORT_CONFIDENCE=0.6

# 可选开发追踪，默认关闭。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# DeepSeek 只用于问答/总结时，可改用下面三项；API Key 仍填在
# PAPERLEAF_OPENAI_API_KEY。DeepSeek 当前不提供 Embeddings API，因此必须关闭向量调用，
# PaperLeaf 会继续使用 PostgreSQL 全文检索，之后可另接独立向量服务。
# PAPERLEAF_OPENAI_BASE_URL=https://api.deepseek.com
# PAPERLEAF_CHAT_MODEL=deepseek-v4-flash
# PAPERLEAF_EMBEDDING_ENABLED=false
