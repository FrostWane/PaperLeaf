# PaperLeaf 本地部署示例。复制为 .env 后务必替换全部 replace-* 值。

# 对外端口
PAPERLEAF_BIND_ADDRESS=127.0.0.1
PAPERLEAF_WEB_PORT=3000
PAPERLEAF_API_PORT=8000
PAPERLEAF_MINIO_PORT=9000
PAPERLEAF_MINIO_CONSOLE_PORT=9001

# Web 在浏览器中访问 API 的地址。生产环境建议通过同域反向代理暴露 /api。
NEXT_PUBLIC_DATA_MODE=real
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=paperleaf
POSTGRES_USER=paperleaf
# Compose 会把该值写入连接 URL，请使用 URL-safe 随机字符。
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# PaperLeaf 服务
PAPERLEAF_MODE=production
PAPERLEAF_SESSION_SECRET=replace-with-at-least-64-random-characters
PAPERLEAF_SECURE_COOKIES=false
PAPERLEAF_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PAPERLEAF_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PAPERLEAF_MAX_PDF_BYTES=52428800
PAPERLEAF_MAX_PDF_PAGES=500
PAPERLEAF_CORS_ORIGINS=http://localhost:3000

# MinIO；容器内 Endpoint 不要写 http:// 前缀。
MINIO_ROOT_USER=paperleaf
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
PAPERLEAF_MINIO_BUCKET=paperleaf-pdfs

# OpenAI-compatible 服务。Key 留空时使用全文检索与确定性降级，不调用外部模型。
PAPERLEAF_OPENAI_API_KEY=
PAPERLEAF_OPENAI_BASE_URL=https://api.openai.com/v1
PAPERLEAF_CHAT_MODEL=gpt-4.1-mini
PAPERLEAF_EMBEDDING_MODEL=text-embedding-3-small
PAPERLEAF_EMBEDDING_DIMENSIONS=
PAPERLEAF_VISION_MODEL=

# 可选开发追踪，默认关闭。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
