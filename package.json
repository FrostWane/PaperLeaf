{
  "name": "paperleaf",
  "version": "0.8.1",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "pnpm": {
    "patchedDependencies": {
      "vinext@0.0.50": "patches/vinext@0.0.50.patch"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:server": "vinext build && vinext start --port 3100",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lighthouse": "lhci autorun",
    "lint": "eslint app components lib tests .storybook vitest.config.ts playwright.config.ts --ignore-pattern dist --ignore-pattern .next --ignore-pattern build --ignore-pattern backend --ignore-pattern worker --ignore-pattern .wrangler --ignore-pattern .vinext"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "geist": "^1.7.2",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "next": "16.2.6",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "react-server-dom-webpack": "19.2.6",
    "storybook": "^10.5.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
